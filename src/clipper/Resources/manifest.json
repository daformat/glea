{
  "manifest_version": 3,
  "name": "Glea Clipper",
  "version": "1.0.0",
  "description": "Point and shoot, selections, articles, images and links into Glea’s journal and notes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Collect to Glea",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open Glea Clipper"
    },
    "collect-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Collect the selection (or the page’s link) to Glea"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "pns-driver.js",
        "vendor/glea-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}