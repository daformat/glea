diff --git a/libavformat/aacdec.c b/libavformat/aacdec.c
index 7968e52..16e48da 100644
--- a/libavformat/aacdec.c
+++ b/libavformat/aacdec.c
@@ -23,6 +23,9 @@
 #include "libavutil/avassert.h"
 #include "libavutil/intreadwrite.h"
 #include "avformat.h"
+#include "libavcodec/adts_header.h"
+#include "libavutil/channel_layout.h"
+#include "libavutil/mem.h"
 #include "avio_internal.h"
 #include "demux.h"
 #include "internal.h"
@@ -129,6 +132,28 @@ static int adts_aac_read_header(AVFormatContext *s)
     if (ret < 0)
         return ret;
 
+    // Glea: its FFmpeg has no AAC decoder (macOS decodes AAC), and that
+    // decoder is what normally reports the stream's rate and channels. Read
+    // them from the first ADTS header, with a matching AudioSpecificConfig.
+    {
+        uint8_t buf[AV_AAC_ADTS_HEADER_SIZE + AV_INPUT_BUFFER_PADDING_SIZE] = { 0 };
+        AACADTSHeaderInfo *hdr = NULL;
+        int64_t pos = avio_tell(s->pb);
+        if (avio_read(s->pb, buf, AV_AAC_ADTS_HEADER_SIZE) == AV_AAC_ADTS_HEADER_SIZE &&
+            avpriv_adts_header_parse(&hdr, buf, sizeof(buf)) >= 0 && hdr->chan_config) {
+            st->codecpar->sample_rate = hdr->sample_rate;
+            st->codecpar->frame_size  = hdr->samples;
+            av_channel_layout_default(&st->codecpar->ch_layout,
+                                      hdr->chan_config == 7 ? 8 : hdr->chan_config);
+            if (ff_alloc_extradata(st->codecpar, 2) >= 0) {
+                st->codecpar->extradata[0] = (hdr->object_type << 3) | (hdr->sampling_index >> 1);
+                st->codecpar->extradata[1] = ((hdr->sampling_index & 1) << 7) | (hdr->chan_config << 3);
+            }
+        }
+        av_free(hdr);
+        avio_seek(s->pb, pos, SEEK_SET);
+    }
+
     // LCM of all possible ADTS sample rates
     avpriv_set_pts_info(st, 64, 1, 28224000);
 
