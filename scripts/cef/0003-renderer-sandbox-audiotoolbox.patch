diff --git a/sandbox/policy/mac/renderer.sb b/sandbox/policy/mac/renderer.sb
index f67307c763..e8ca64d5ae 100644
--- a/sandbox/policy/mac/renderer.sb
+++ b/sandbox/policy/mac/renderer.sb
@@ -77,6 +77,12 @@
   (ipc-posix-name "apple.shm.notification_center")  ; https://crbug.com/792217
 )
 
+; Glea: Web Audio's decodeAudioData() decodes AAC with AudioToolbox in the
+; renderer (Glea's FFmpeg has no AAC decoder). Allow the same two things the
+; GPU process profile allows for AudioToolbox AAC decoding.
+(allow mach-lookup (global-name "com.apple.audio.AudioComponentRegistrar"))
+(allow file-read* (subpath "/System/Library/Components/AudioCodecs.component"))
+
 ; mach IPC
 (allow mach-lookup
   (global-name "com.apple.cvmsServ")  ; https://crbug.com/850021
