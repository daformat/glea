+std::vector<uint8_t> MakeAudioSpecificConfig(const AudioDecoderConfig& config) {
+  static constexpr int kRates[] = {96000, 88200, 64000, 48000, 44100,
+                                   32000, 24000, 22050, 16000, 12000,
+                                   11025, 8000,  7350};
+  int rate_index = 4;  // 44.1 kHz
+  for (size_t i = 0; i < std::size(kRates); ++i) {
+    if (kRates[i] == config.samples_per_second()) {
+      rate_index = static_cast<int>(i);
+    }
+  }
+  const int channels = std::clamp(config.channels(), 1, 7);
+  const int object_type = 2;  // AAC-LC
+  return {static_cast<uint8_t>((object_type << 3) | (rate_index >> 1)),
+          static_cast<uint8_t>(((rate_index & 1) << 7) | (channels << 3))};
